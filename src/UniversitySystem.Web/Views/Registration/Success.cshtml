@{
    ViewData["Title"] = "Inscription réussie";
}

<!-- Modale Bootstrap qui s'affiche automatiquement au chargement de la page -->
<div class="modal fade show" id="successModal" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">✅ Inscription réussie</h5>
            </div>
            <div class="modal-body text-center p-4">
                <p class="lead">
                    Inscription réussie. Veuillez vous reconnecter sous 48 heures pour voir si votre inscription sera validée ou pas après étude du dossier.
                </p>
            </div>
            <div class="modal-footer justify-content-center">
                <a href="/" class="btn btn-primary btn-lg">OK</a>
            </div>
        </div>
    </div>
</div>