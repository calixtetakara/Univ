@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center mt-5">
    <h1 class="display-5">Système de Gestion Universitaire</h1>
    <p class="lead mt-3">
        Bienvenue. Connectez-vous pour accéder à votre espace.
    </p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-primary btn-lg mt-3" asp-controller="Account" asp-action="Login">
            Se connecter
        </a>
    }
    else
    {
        <div class="alert alert-success mt-4 d-inline-block">
            Vous êtes connecté en tant que <strong>@User.Identity.Name</strong>
        </div>
    }
</div>