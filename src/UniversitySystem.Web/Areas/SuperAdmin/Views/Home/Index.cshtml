@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="container-fluid py-4">
    <!-- En-tête de bienvenue -->
    <div class="row mb-5">
        <div class="col-12">
            <h1 class="fw-bold text-dark">Tableau de bord <span class="text-primary">Super-Admin</span></h1>
            <p class="text-muted fs-5">Bienvenue dans votre espace d'administration centralisé.</p>
        </div>
    </div>

    <!-- Cartes de statistiques (KPI) -->
    <div class="row g-4 mb-5">
        <!-- Carte Étudiants -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 hover-card bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-people-fill text-primary" viewBox="0 0 16 16">
                                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
                            </svg>
                        </div>
                    </div>
                    <h6 class="text-muted text-uppercase fw-semibold mb-1">Étudiants validés</h6>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalEtudiants</h2>
                </div>
            </div>
        </div>

        <!-- Carte Enseignants -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 hover-card bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-video3 text-success" viewBox="0 0 16 16">
                                <path d="M14 9.5a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm-6 5.7c0 .8.7 1.3 1.5 1.3h5c.8 0 1.5-.5 1.5-1.3 0-2.1-1.3-3.2-4-3.2s-4 1.1-4 3.2Z"/>
                                <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h6.5a.5.5 0 0 1 0-1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2H2Z"/>
                            </svg>
                        </div>
                    </div>
                    <h6 class="text-muted text-uppercase fw-semibold mb-1">Enseignants</h6>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalEnseignants</h2>
                </div>
            </div>
        </div>

        <!-- Carte Dossiers en attente -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 hover-card bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-hourglass-split text-warning" viewBox="0 0 16 16">
                                <path d="M2.5 15a.5.5 0 1 1 0-1h1v-1a4.5 4.5 0 0 1 2.557-4.06c.29-.139.443-.377.443-.59v-.7c0-.213-.154-.451-.443-.59A4.5 4.5 0 0 1 3.5 3V2h-1a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1h-1v1a4.5 4.5 0 0 1-2.557 4.06c-.29.139-.443.377-.443.59v.7c0 .213.154.451.443.59A4.5 4.5 0 0 1 12.5 13v1h1a.5.5 0 0 1 0 1h-11zm2-13v1c0 .537.12 1.045.337 1.5h6.326c.216-.455.337-.963.337-1.5V2h-7zm3 6.35c0 .701-.478 1.236-1.011 1.492A3.5 3.5 0 0 0 4.5 13s.866-1.299 3-1.48V8.35zm1 0v3.17c2.134.181 3 1.48 3 1.48a3.5 3.5 0 0 0-1.989-3.158C8.978 9.586 8.5 9.052 8.5 8.351z"/>
                            </svg>
                        </div>
                    </div>
                    <h6 class="text-muted text-uppercase fw-semibold mb-1">Dossiers en attente</h6>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.DossiersEnAttente</h2>
                </div>
            </div>
        </div>

        <!-- Carte Chiffre d'Affaires -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 hover-card bg-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="bg-info bg-opacity-10 p-3 rounded-circle">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cash-stack text-info" viewBox="0 0 16 16">
                                <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                                <path d="M1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4zm8 0a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/>
                            </svg>
                        </div>
                    </div>
                    <h6 class="text-muted text-uppercase fw-semibold mb-1">Chiffre d'affaires</h6>
                    <h2 class="fw-bold mb-0 text-dark">@ViewBag.TotalPaiements.ToString("N0") <small class="fs-6 text-muted">FCFA</small></h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Raccourcis rapides -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Gestion des accès</h4>
                    <p class="text-muted mb-4">Gérez les rôles, les permissions et les accès individuels des utilisateurs.</p>
                    <div class="d-grid gap-2">
                        <a asp-action="Roles" asp-controller="Permissions" class="btn btn-outline-primary py-2 rounded-3 fw-semibold">Permissions par rôle</a>
                        <a asp-action="Users" asp-controller="Permissions" class="btn btn-outline-primary py-2 rounded-3 fw-semibold">Permissions individuelles</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Suivi & Analyses</h4>
                    <p class="text-muted mb-4">Consultez les transactions financières et les indicateurs de performance.</p>
                    <div class="d-grid gap-2">
                        <a asp-action="Index" asp-controller="Finances" class="btn btn-outline-success py-2 rounded-3 fw-semibold">Voir les finances</a>
                        <a asp-action="Index" asp-controller="Kpi" class="btn btn-outline-info py-2 rounded-3 fw-semibold">Voir les KPI</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Style pour l'effet de survol -->
<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>