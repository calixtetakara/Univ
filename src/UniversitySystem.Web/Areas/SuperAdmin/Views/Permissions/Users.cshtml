@model IEnumerable<UniversitySystem.Domain.Entities.Utilisateur>

@{
    ViewData["Title"] = "Permissions individuelles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Permissions individuelles</h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Filtre de recherche -->
<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Rechercher par email ou nom..." value="@ViewBag.Search" />
        <button type="submit" class="btn btn-primary">Rechercher</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Nom complet</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Nom @u.Prenom</td>
                <td>@u.Email</td>
                <td>@u.Role.Nom</td>
                <td>
                    <a asp-action="UserDetails" asp-route-id="@u.IdUtilisateur" class="btn btn-sm btn-primary">
                        Gérer les overrides
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>