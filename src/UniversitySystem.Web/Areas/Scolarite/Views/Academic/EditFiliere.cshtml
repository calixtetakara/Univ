@model UniversitySystem.Web.Models.FiliereEditViewModel
@using UniversitySystem.Domain.Entities

@{
    ViewData["Title"] = "Modifier la filière";
    var facultes = ViewBag.Facultes as List<Faculte> ?? new List<Faculte>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Modifier la filière</h4>
            </div>
            <div class="card-body">
                <form asp-action="EditFiliere" asp-route-id="@Model.CodeFiliere" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CodeFiliere" class="form-label"></label>
                        <input asp-for="CodeFiliere" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CodeFaculte" class="form-label">Faculté</label>
                        <select asp-for="CodeFaculte" class="form-select">
                            @foreach (var f in facultes)
                            {
                                <option value="@f.CodeFaculte">@f.NomFaculte</option>
                            }
                        </select>
                        <span asp-validation-for="CodeFaculte" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NomFiliere" class="form-label"></label>
                        <input asp-for="NomFiliere" class="form-control" />
                        <span asp-validation-for="NomFiliere" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a asp-action="Filieres" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>