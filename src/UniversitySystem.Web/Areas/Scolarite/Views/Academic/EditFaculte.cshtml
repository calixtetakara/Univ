@model UniversitySystem.Web.Models.FaculteEditViewModel

@{
    ViewData["Title"] = "Modifier la faculté";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Modifier la faculté</h4>
            </div>
            <div class="card-body">
                <form asp-action="EditFaculte" asp-route-id="@Model.CodeFaculte" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="CodeFaculte" class="form-label"></label>
                        <input asp-for="CodeFaculte" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NomFaculte" class="form-label"></label>
                        <input asp-for="NomFaculte" class="form-control" />
                        <span asp-validation-for="NomFaculte" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TypeFaculte" class="form-label"></label>
                        @if (Model.CanEditType)
                        {
                            <select asp-for="TypeFaculte" asp-items="Html.GetEnumSelectList<UniversitySystem.Domain.Enums.TypeFaculte>()" class="form-select"></select>
                        }
                        else
                        {
                            <input type="hidden" asp-for="TypeFaculte" />
                            <input class="form-control" value="@Model.TypeFaculte" disabled />
                            <small class="text-danger">Non modifiable : des étudiants sont déjà inscrits dans cette faculté.</small>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a asp-action="Facultes" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>