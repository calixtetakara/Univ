@model UniversitySystem.Domain.Entities.Etudiant

@{
    Layout = "_Layout";
    ViewData["Title"] = "Mon dossier - En cours";
    var timeLeft = ViewData["TimeLeft"] as TimeSpan? ?? TimeSpan.Zero;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <!-- Alerte en cours -->
            <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-start">
                <div class="me-3 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-hourglass-split text-warning" viewBox="0 0 16 16">
                        <path d="M2.5 15a.5.5 0 1 1 0-1h1v-1a4.5 4.5 0 0 1 2.557-4.06c.29-.139.443-.377.443-.59v-.7c0-.213-.154-.451-.443-.59A4.5 4.5 0 0 1 3.5 3V2h-1a.5.5 0 0 1 0-1h11a.5.5 0 0 1 0 1h-1v1a4.5 4.5 0 0 1-2.557 4.06c-.29.139-.443.377-.443.59v.7c0 .213.154.451.443.59A4.5 4.5 0 0 1 12.5 13v1h1a.5.5 0 0 1 0 1h-11zm2-13v1c0 .537.12 1.045.337 1.5h6.326c.216-.455.337-.963.337-1.5V2h-7zm3 6.35c0 .701-.478 1.236-1.011 1.492A3.5 3.5 0 0 0 4.5 13s.866-1.299 3-1.48V8.35zm1 0v3.17c2.134.181 3 1.48 3 1.48a3.5 3.5 0 0 0-1.989-3.158C8.978 9.586 8.5 9.052 8.5 8.351z"/>
                    </svg>
                </div>
                <div class="w-100">
                    <h4 class="alert-heading fw-bold mb-2">Statut : Dossier en cours de traitement</h4>
                    <p>Les options de paiement seront disponibles une fois le dossier validé par la scolarité.</p>
                    <hr>
                    <p class="mb-0 d-flex justify-content-between align-items-center">
                        <span><strong>Compte à rebours (48h) :</strong></span>
                        <span id="countdown" class="fs-4 fw-bold text-danger">@timeLeft.ToString(@"hh\:mm\:ss")</span>
                    </p>
                </div>
            </div>

            <!-- Carte d'information -->
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h5 class="mb-4 text-primary fw-bold">Informations du dossier</h5>
                    
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent">
                            <span class="text-muted fw-semibold">Nom complet</span>
                            <span class="fw-bold fs-5 text-dark">@Model.Utilisateur.Nom @Model.Utilisateur.Prenom</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent">
                            <span class="text-muted fw-semibold">Numéro de table</span>
                            <span class="fw-bold text-dark">@Model.NumTableBac (Session @Model.SessionBac)</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent">
                            <span class="text-muted fw-semibold">Faculté</span>
                            <span class="fw-bold text-dark">@Model.Filiere?.Faculte?.NomFaculte</span>
                        </li>
                        <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
                            <span class="text-muted fw-semibold">Filière</span>
                            <span class="fw-bold text-dark">@Model.Filiere?.NomFiliere</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Bouton Déconnexion -->
            <div class="text-center mt-4">
                <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger px-4 rounded-pill">
                        <i class="bi bi-box-arrow-right me-2"></i> Se déconnecter
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timeLeftSeconds = @((int)timeLeft.TotalSeconds);
        const countdownEl = document.getElementById('countdown');

        function updateCountdown() {
            if (timeLeftSeconds <= 0) {
                countdownEl.textContent = "Délai dépassé";
                return;
            }
            timeLeftSeconds--;
            const h = String(Math.floor(timeLeftSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((timeLeftSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(timeLeftSeconds % 60).padStart(2, '0');
            countdownEl.textContent = `${h}:${m}:${s}`;
        }

        if (timeLeftSeconds > 0) {
            setInterval(updateCountdown, 1000);
        }
    </script>
}