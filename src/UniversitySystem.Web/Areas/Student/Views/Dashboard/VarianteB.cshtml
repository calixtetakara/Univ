@model UniversitySystem.Domain.Entities.Etudiant

@{
    Layout = "_Layout";
    ViewData["Title"] = "Mon dossier";
}

<div class="alert alert-success">
    <h4 class="alert-heading">Félicitations, votre dossier est validé !</h4>
    <p>Votre matricule est : <strong class="fs-4">@Model.Matricule</strong></p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white">Identité</div>
            <div class="card-body">
                <p><strong>Nom :</strong> @Model.Utilisateur.Nom @Model.Utilisateur.Prenom</p>
                <p><strong>Matricule :</strong> @Model.Matricule</p>
                <p><strong>Faculté :</strong> @Model.Filiere?.Faculte?.NomFaculte</p>
                <p><strong>Filière :</strong> @Model.Filiere?.NomFiliere</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white">Paiement</div>
            <div class="card-body text-center">
                <p class="mb-4">Vous pouvez maintenant procéder au paiement de vos frais de scolarité.</p>
                <!-- URL en dur pour être sûr que ça fonctionne -->
                <a href="/Student/Payment/Index" class="btn btn-success btn-lg w-100">
                    Procéder au paiement
                </a>
            </div>
        </div>
    </div>
</div>